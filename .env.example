PORT=3978
DATABASE_PATH=./data/team-fortune-bot.sqlite
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=
# 카드 아이콘 주소의 앞부분입니다. 비우면 아이콘이 상대 경로가 되어 Teams에서 보이지 않습니다
PUBLIC_BASE_URL=https://fortune-bot.namonak.dev
# 비우면 LLM을 부르지 않고 템플릿 문장만 씁니다
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_REASONING_EFFORT=low
# 아래 생일은 형식 예시입니다. 실제 팀원 이름과 생일(양력, 이름:MM-DD)으로 바꿔 적고 이 파일은 저장소에 올리지 않습니다
BIRTHDAYS=홍길동:12-12,김철수:02-04
